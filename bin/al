#!/usr/bin/env node

import { Command } from 'commander';
import dotenv from 'dotenv';
import { execFileSync } from 'child_process';
import path from 'path';
import { fileURLToPath } from 'url';

import { getStocks } from '../src/commands/finance/get/stocks.js';
import { getCash } from '../src/commands/finance/get/cash.js';
import { getOrders } from '../src/commands/finance/get/orders.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const PYTHON_ROOT = path.join(__dirname, '..', 'src_py');

dotenv.config();

const program = new Command();

program
  .name('al')
  .description('AL CLI - Manage your finances (Hybrid JS/Python)')
  .version('1.0.0');

// Python 서브커맨드 핸들러 함수 
function runPythonScript(scriptPath, args = []) {
  try {
    const result = execFileSync('python3', [scriptPath, ...args], {
      stdio: 'inherit',
      cwd: path.join(__dirname, '..')
    });
  } catch (error) {
    process.exit(error.code || 1);
  }
}

const pyCommand = program
  .command('py')
  .description('Run Python scripts from src_py');

pyCommand
  .command('stocks')
  .description('Get stock information via Python (KIS API & yfinance)')
  .action(() => {
    runPythonScript(path.join(PYTHON_ROOT, 'commands', 'finance', 'get', 'stocks.py'));
  });

const finance = program
  .command('finance')
  .description('Finance operations');

const get = finance
  .command('get')
  .description('Retrieve financial data');

get
  .command('stocks')
  .description('Get stock information (JS)')
  .option('--json', 'Output as JSON with ticker information')
  .action((options) => getStocks(options));

get
  .command('cash')
  .description('Get cash information')
  .action(getCash);

get
  .command('orders')
  .description('Get order/execution history (주문체결내역)')
  .option('--start <date>', 'Start date (YYYYMMDD), default: today')
  .option('--end <date>', 'End date (YYYYMMDD), default: today')
  .option('--json', 'Output as JSON')
  .option('--ccld <type>', 'Execution type (all|filled|unfilled, default: all)')
  .option('--sll-buy <type>', 'Sell/Buy (all|sell|buy, default: all)')
  .option('--pdno <code>', '상품번호 (특정 종목만 조회)')
  .option('--ovrs-excg <code>', '해외거래소코드 (NASD/NYSE/AMEX 등)')
  .action((options) => getOrders(options));

program.parse();
